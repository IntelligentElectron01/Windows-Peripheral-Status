<Window x:Class="WirelessDeviceMonitor.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wireless Device Monitor" Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Fg}" UseLayoutRounding="True">
  <Window.Resources>
    <!-- A whole-width row that opens another page: highlights under the pointer like a list item. -->
    <Style x:Key="NavRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,0" Padding="8,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="Margin" Value="16,14,16,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Border CornerRadius="8" Background="{DynamicResource Bg}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.28"/>
      </Border.Effect>
    </Border>
    <Border x:Name="Card" CornerRadius="8" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
      <StackPanel>
        <!-- Header: the app name on the device list; a back arrow and the page name on the settings pages -->
        <Grid Margin="16,12,10,12" MinHeight="36">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="-8,0,6,0"
                  ToolTip="Back" Click="Back_Click" Visibility="Collapsed" AutomationProperties.Name="Back"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Wireless Device Monitor" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="SyncText" Text="Last synced: not yet" FontSize="12"
                       Foreground="{DynamicResource Fg2}" Margin="0,2,0,0"/>
          </StackPanel>
          <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;"
                  ToolTip="Refresh now" Click="Refresh_Click"/>
          <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;"
                  ToolTip="Settings" Click="Settings_Click"/>
        </Grid>
        <Border Height="1" Background="{DynamicResource Stroke}"/>

        <!-- Page 1: devices, and nothing else -->
        <StackPanel x:Name="MainPage">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
          <ScrollViewer MaxHeight="336" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6">
            <ItemsControl x:Name="DeviceList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="16,7,8,7" Background="Transparent" Tag="{Binding Id}"
                        ToolTip="{Binding RowTip}" MouseLeftButtonUp="Row_Click" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                               Foreground="{Binding GlyphBrush}" VerticalAlignment="Center" Opacity="{Binding Fade}"/>
                    <Path Grid.RowSpan="2" Data="{Binding Icon}" Fill="{Binding GlyphBrush}" Height="16" MaxWidth="22"
                          Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="{Binding Fade}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Opacity="{Binding Fade}"/>
                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" Foreground="{DynamicResource Fg2}"
                               Margin="8,0,6,0" VerticalAlignment="Center" Opacity="{Binding Fade}"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Bar}"
                                 Value="{Binding Level, Mode=OneWay}" Foreground="{Binding BarBrush}"
                                 Visibility="{Binding BarVisibility}" Margin="0,7,6,0"/>
                    <Button Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource IconButton}"
                            Content="{Binding PinGlyph}" Foreground="{Binding PinBrush}" ToolTip="{Binding PinTip}"
                            Tag="{Binding Id}" Click="Pin_Click"/>
                    <Button Grid.Column="4" Grid.RowSpan="2" Style="{StaticResource IconButton}" Content="&#xE712;"
                            ToolTip="History, rename, hide" Tag="{Binding Id}" Click="More_Click"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="EmptyText" Margin="16,10,16,16" TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{DynamicResource Fg2}"/>
        </StackPanel>

        <!-- Page 2: settings (gear button) -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" MaxHeight="560" VerticalScrollBarVisibility="Auto">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel>
            <Button x:Name="NotificationsRow" Style="{StaticResource NavRow}" Margin="0,8,0,0" Click="Notifications_Click"
                    AutomationProperties.Name="Notifications">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Notifications"/>
                  <TextBlock x:Name="NotificationsSummary" Text="" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="12"
                           Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <TextBlock Text="Appearance" Style="{StaticResource Group}"/>
            <Grid Margin="16,10,16,0">
              <TextBlock Text="Accent colour" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="AccentBlue" Style="{StaticResource Chip}" Content="Blue" GroupName="accent" Click="Accent_Click"/>
                <RadioButton x:Name="AccentSystem" Style="{StaticResource Chip}" Content="Windows accent" GroupName="accent" Click="Accent_Click"/>
              </StackPanel>
            </Grid>
            <Grid Margin="16,10,16,0">
              <TextBlock Text="Show pinned" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="PinTaskbar" Style="{StaticResource Chip}" Content="On taskbar" GroupName="pinmode" Click="PinMode_Click"/>
                <RadioButton x:Name="PinTray" Style="{StaticResource Chip}" Content="As tray icons" GroupName="pinmode" Click="PinMode_Click"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Devices" Style="{StaticResource Group}"/>
            <Grid Margin="16,10,16,0">
              <TextBlock Text="Logitech wireless devices" VerticalAlignment="Center"
                         ToolTip="Asks Logitech mice and keyboards on a USB receiver for their battery level every 2 minutes. This is the only reader that sends messages to a device."/>
              <CheckBox x:Name="LogitechToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                        Click="LogitechToggle_Click" AutomationProperties.Name="Logitech wireless devices"/>
            </Grid>
            <StackPanel x:Name="HiddenPanel" Margin="16,12,16,0">
              <TextBlock Text="Hidden devices" Foreground="{DynamicResource Fg2}" FontSize="12"/>
              <ItemsControl x:Name="HiddenList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4,0,0">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                      <Button Style="{StaticResource StdButton}" Content="Show" Padding="10,3" HorizontalAlignment="Right"
                              Tag="{Binding Id}" Click="Unhide_Click"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="App" Style="{StaticResource Group}"/>
            <Grid Margin="16,10,16,0">
              <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
              <CheckBox x:Name="StartToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                        Click="StartToggle_Click" AutomationProperties.Name="Start with Windows"/>
            </Grid>
            <Grid Margin="16,10,16,0">
              <TextBlock Text="Shortcut to open" VerticalAlignment="Center"
                         ToolTip="A key combination that opens this panel from anywhere. It must include Ctrl, Alt or the Windows key."/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="HotkeyClear" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                        ToolTip="Remove the shortcut" Click="HotkeyClear_Click"/>
                <Button x:Name="HotkeyButton" Style="{StaticResource StdButton}" Content="Not set" Padding="10,4" MinWidth="96"
                        ToolTip="Click, then press the keys you want" Click="HotkeyButton_Click"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="HotkeyHint" Margin="16,6,16,0" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource Fg2}"/>

            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,16,0,0"/>
            <TextBlock Margin="16,12,16,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                       Text="Shows Bluetooth devices and Logitech wireless devices on a USB receiver. Other 2.4 GHz USB-dongle devices aren't supported."/>
            <Button Style="{StaticResource StdButton}" Content="Exit application" Margin="16,12,16,16" Click="Exit_Click"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Page 3: notifications (opened from the settings page) -->
        <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
          <TextBlock Text="Popups" Style="{StaticResource Group}"/>
          <Grid Margin="16,10,16,0">
            <TextBlock Text="Low battery" VerticalAlignment="Center"
                       ToolTip="A popup when a device drops to the level below."/>
            <CheckBox x:Name="LowToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="LowToggle_Click" AutomationProperties.Name="Low-battery notification"/>
          </Grid>
          <Grid Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ThresholdText" Text="Notify at 20%" VerticalAlignment="Center" MinWidth="96"
                       Foreground="{DynamicResource Fg2}"/>
            <Slider x:Name="ThresholdSlider" Grid.Column="1" Style="{StaticResource FlatSlider}"
                    Minimum="10" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" LargeChange="5" SmallChange="5"
                    ValueChanged="Threshold_Changed" AutomationProperties.Name="Low-battery threshold"/>
          </Grid>
          <Grid Margin="16,12,16,0">
            <TextBlock Text="Device connected" VerticalAlignment="Center"
                       ToolTip="A small pill drops down from the top of the screen for a few seconds. Devices on a USB receiver are left out."/>
            <CheckBox x:Name="ConnectPopupToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="ConnectPopupToggle_Click" AutomationProperties.Name="Popup when a device connects"/>
          </Grid>
          <Grid Margin="16,12,16,0">
            <TextBlock Text="Sound output changed" VerticalAlignment="Center"
                       ToolTip="A popup naming the new output, however it was changed."/>
            <CheckBox x:Name="OutputToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="OutputToggle_Click" AutomationProperties.Name="Popup when the sound output changes"/>
          </Grid>
          <Grid Margin="16,12,16,0">
            <TextBlock Text="Microphone changed" VerticalAlignment="Center"
                       ToolTip="A popup naming the new microphone, however it was changed."/>
            <CheckBox x:Name="InputToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="InputToggle_Click" AutomationProperties.Name="Popup when the microphone changes"/>
          </Grid>
          <Grid Margin="16,12,16,0">
            <TextBlock Text="Hide popups in full-screen apps" VerticalAlignment="Center"
                       ToolTip="No popups while a game or video fills the screen. A low-battery warning goes to Windows notifications instead."/>
            <CheckBox x:Name="QuietToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="QuietToggle_Click" AutomationProperties.Name="Hide popups in full-screen apps"/>
          </Grid>

          <TextBlock Text="Windows notifications" Style="{StaticResource Group}"/>
          <Grid Margin="16,10,16,16">
            <TextBlock Text="Pinned device disconnected" VerticalAlignment="Center"
                       ToolTip="A Windows notification when a pinned device disconnects."/>
            <CheckBox x:Name="DisconnectToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                      Click="DisconnectToggle_Click" AutomationProperties.Name="Notify on disconnect"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
